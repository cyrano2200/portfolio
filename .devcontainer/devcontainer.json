{
  "name": "Bahji portfolio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Portfolio",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "postStartCommand": "bash .devcontainer/start-server.sh"
}
